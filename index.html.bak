                        <div id="image-duration-container" style="display: none; align-items: center; gap: 10px; margin-top: 8px; padding: 6px 12px; background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 6px; width: 100%;">
