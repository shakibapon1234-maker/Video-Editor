<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Antigravity Premium Video Editor | FB & Reels Studio</title>
    <link rel="stylesheet" href="style.css?v=17">
    <!-- Google Fonts for Modern Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&family=Galada&family=Montserrat:wght@400;600;700;800&family=Poppins:wght@400;600;700&family=Bebas+Neue&family=Anton&family=Oswald:wght@400;600;700&family=Playfair+Display:wght@600;700&family=Caveat:wght@600;700&family=Pacifico&family=Archivo+Black&family=Righteous&family=Permanent+Marker&family=Baloo+Da+2:wght@600;700&family=Tiro+Bangla&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Apply saved theme immediately to prevent a flash of the wrong theme -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem('studioflow-theme') || 'dark';
                if (t !== 'dark') document.documentElement.setAttribute('data-theme', t);
            } catch (e) {}
        })();
        function openShortcutsModal() {
            var modal = document.getElementById('shortcuts-modal');
            if (modal) {
                modal.style.setProperty('display', 'flex', 'important');
                modal.style.setProperty('z-index', '9999999', 'important');
            }
        }
        function closeShortcutsModal() {
            var modal = document.getElementById('shortcuts-modal');
            if (modal) {
                modal.style.setProperty('display', 'none', 'important');
            }
        }
    </script>
</head>
<body>
    <div class="app-container">
        <!-- Sidebar Navigation / Workflow Tracker -->
        <aside class="sidebar" id="app-sidebar">
            <button id="sidebar-toggle-btn" class="sidebar-toggle-btn" type="button" title="à¦¸à¦¾à¦‡à¦¡ à¦®à§‡à¦¨à§ à¦¬à¦¨à§à¦§/à¦–à§‹à¦²à¦¾ à¦•à¦°à§à¦¨ (Collapse/Expand sidebar)">
                <i class="fa-solid fa-angles-left"></i>
            </button>
            <div class="brand">
                <i class="fa-solid fa-video brand-icon"></i>
                <div class="brand-text">
                    <h2>Studio Flow</h2>
                    <span>Facebook & Reels Editor</span>
                </div>
            </div>
            
            <nav class="nav-steps">
                <div class="step-item active" data-step="1" id="step-btn-1">
                    <div class="step-number">1</div>
                    <div class="step-info">
                        <h3>Media Import</h3>
                        <p>Upload Video & Logo</p>
                    </div>
                </div>
                <div class="step-item" data-step="2" id="step-btn-2">
                    <div class="step-number">2</div>
                    <div class="step-info">
                        <h3>Trim & Layout</h3>
                        <p>Cut video & adjust aspect</p>
                    </div>
                </div>
                <div class="step-item" data-step="3" id="step-btn-3">
                    <div class="step-number">3</div>
                    <div class="step-info">
                        <h3>Overlays & B-roll</h3>
                        <p>Texts & B-roll animations</p>
                    </div>
                </div>
                <div class="step-item" data-step="4" id="step-btn-4">
                    <div class="step-number">4</div>
                    <div class="step-info">
                        <h3>Audio & Voice</h3>
                        <p>Noise cancel & voiceover</p>
                    </div>
                </div>
                <div class="step-item" data-step="5" id="step-btn-5">
                    <div class="step-number">5</div>
                    <div class="step-info">
                        <h3>Export Studio</h3>
                        <p>Render & Download</p>
                    </div>
                </div>
            </nav>

            <div class="sidebar-footer">
                <p>100% Free & Local</p>
                <small>No server required</small>
            </div>
        </aside>

        <!-- Main Workspace -->
        <main class="workspace">
            <header class="workspace-header" id="app-workspace-header">
                <div class="header-title">
                    <h1 id="current-step-title">Media Import</h1>
                    <p id="current-step-subtitle">Start by uploading your video clip and branding logo</p>
                </div>
                <div class="header-actions">
                    <button id="always-on-top-btn" class="btn btn-outline btn-sm" type="button" title="à¦‰à¦‡à¦¨à§à¦¡à§‹ à¦¸à¦¬à¦¸à¦®à§Ÿ à¦¸à¦¬à¦¾à¦° à¦‰à¦ªà¦°à§‡ à¦ªà¦¿à¦¨ à¦•à¦°à§‡ à¦°à¦¾à¦–à§à¦¨ (Always On Top - PotPlayer Style)">
                        <i class="fa-solid fa-thumbtack"></i> <span id="always-on-top-text" style="margin-left:4px; font-weight:600;">Pin</span>
                    </button>
                    <button id="floating-transport-toggle-btn" class="btn btn-outline btn-sm floating-transport-toggle-btn" type="button" title="à¦ªà§à¦²à§‡à¦¹à§‡à¦¡/à¦ªà§à¦²à§‡à¦¬à§à¦¯à¦¾à¦• à¦•à¦¨à§à¦Ÿà§à¦°à§‹à¦² à¦†à¦²à¦¾à¦¦à¦¾ à¦­à¦¾à¦¸à¦®à¦¾à¦¨ à¦ªà§à¦¯à¦¾à¦¨à§‡à¦²à§‡ à¦¬à§‡à¦° à¦•à¦°à§à¦¨ â€” à¦¯à§‡à¦•à§‹à¦¨à§‹ à¦œà¦¾à¦¯à¦¼à¦—à¦¾à¦¯à¦¼ à¦¬à¦¸à¦¾à¦¤à§‡ à¦ªà¦¾à¦°à¦¬à§‡à¦¨ (Detach floating playhead control)">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </button>
                    <div id="theme-switcher-mount" style="margin-right: 8px;"></div>
                    <div class="history-controls" style="display: flex; align-items: center; gap: 4px; margin-right: 8px;">
                        <button id="undo-btn" class="btn btn-outline btn-sm" type="button" title="Undo (Ctrl+Z)" disabled>
                            <i class="fa-solid fa-rotate-left"></i>
                        </button>
                        <button id="redo-btn" class="btn btn-outline btn-sm" type="button" title="Redo (Ctrl+Y)" disabled>
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                        <div class="history-panel-wrap" style="position: relative;">
                            <button id="history-panel-toggle" class="btn btn-outline btn-sm" type="button" title="à¦à¦¡à¦¿à¦Ÿà¦¿à¦‚ à¦¹à¦¿à¦¸à§à¦Ÿà§à¦°à¦¿ à¦¦à§‡à¦–à§à¦¨ â€” à¦•à¦–à¦¨ à¦•à§€ à¦•à¦¾à¦œ à¦¹à¦¯à¦¼à§‡à¦›à§‡ (History)">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                                <span id="history-count-badge" class="history-count-badge hidden">0</span>
                            </button>
                            <ul id="history-panel-list" class="history-panel-dropdown"></ul>
                        </div>
                        <button id="shortcuts-header-btn" class="shortcuts-help-btn" type="button" title="à¦•à§€à¦¬à§‹à¦°à§à¦¡ à¦¶à¦°à§à¦Ÿà¦•à¦¾à¦Ÿ à¦•à¦¿ à¦¤à¦¾à¦²à¦¿à¦•à¦¾ à¦¦à§‡à¦–à§à¦¨" onclick="openShortcutsModal();">
                            <i class="fa-solid fa-keyboard"></i> Shortcuts
                        </button>
                    </div>
                    <button id="saved-projects-btn" class="btn btn-outline" data-tooltip="à¦†à¦ªà¦¨à¦¾à¦° à¦¸à¦‚à¦°à¦•à§à¦·à¦¿à¦¤ à¦ªà§à¦°à¦œà§‡à¦•à§à¦Ÿà¦¸à¦®à§‚à¦¹à§‡à¦° à¦¤à¦¾à¦²à¦¿à¦•à¦¾ à¦¦à§‡à¦–à§à¦¨ (Saved Video Projects)">
                        <i class="fa-solid fa-list-check"></i> Projects (à¦ªà§à¦°à¦œà§‡à¦•à§à¦Ÿà¦¸à¦®à§‚à¦¹)
                    </button>
                    <button id="save-project-btn" class="btn btn-outline" data-tooltip="à¦ªà§à¦°à¦œà§‡à¦•à§à¦Ÿ à¦«à¦¾à¦‡à¦² à¦¸à¦‚à¦°à¦•à§à¦·à¦£ à¦•à¦°à§à¦¨ (Save Project)">
                        <i class="fa-solid fa-floppy-disk"></i> Save Project
                    </button>
                    <button id="load-project-btn" class="btn btn-outline" data-tooltip="à¦¸à¦‚à¦°à¦•à§à¦·à¦¿à¦¤ à¦ªà§à¦°à¦œà§‡à¦•à§à¦Ÿ à¦«à¦¾à¦‡à¦² à¦²à§‹à¦¡ à¦•à¦°à§à¦¨ (Load Project)">
                        <i class="fa-solid fa-folder-open"></i> Load Project
                    </button>
                    <button id="clear-all-edits-btn" class="btn btn-outline" data-tooltip="à¦¬à¦°à§à¦¤à¦®à¦¾à¦¨ à¦­à¦¿à¦¡à¦¿à¦“à¦° à¦¸à¦®à¦¸à§à¦¤ à¦à¦¡à¦¿à¦Ÿ à¦•à§à¦²à¦¿à¦¯à¦¼à¦¾à¦° à¦•à¦°à§‡ à¦«à§à¦°à§‡à¦¶ à¦•à¦°à§à¦¨ (Clear All Edits)" style="color: #f59e0b; border-color: rgba(245,158,11,0.4); background: rgba(245,158,11,0.05);">
                        <i class="fa-solid fa-broom"></i> Clear All (à¦•à§à¦²à¦¿à¦¯à¦¼à¦¾à¦° à¦…à¦²)
                    </button>
                    <button id="reset-editor-btn" class="btn btn-outline" data-tooltip="à¦à¦¡à¦¿à¦Ÿà¦° à¦¸à¦®à§à¦ªà§‚à¦°à§à¦£ à¦°à¦¿à¦¸à§‡à¦Ÿ à¦•à¦°à§à¦¨ (Reset Editor / Start Fresh)" style="color: #ef4444; border-color: rgba(239,68,68,0.4); background: rgba(239,68,68,0.05);">
                        <i class="fa-solid fa-trash-can"></i> New Project
                    </button>
                    <input type="file" id="project-file-input" accept=".json" style="display: none;">
                    
                    <button id="prev-btn" class="btn btn-secondary" disabled data-tooltip="à¦ªà§‚à¦°à§à¦¬à¦¬à¦°à§à¦¤à§€ à¦§à¦¾à¦ªà§‡ à¦«à¦¿à¦°à§‡ à¦¯à¦¾à¦¨ (Go back to previous step)">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </button>
                    <button id="next-btn" class="btn btn-primary" disabled data-tooltip="à¦ªà¦°à¦¬à¦°à§à¦¤à§€ à¦§à¦¾à¦ªà§‡ à¦à¦—à¦¿à§Ÿà§‡ à¦¯à¦¾à¦¨ (Go to next step)">
                        Next <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </header>

            <button id="header-collapse-toggle" class="header-toggle-tab" type="button" title="à¦‰à¦ªà¦°à§‡à¦° à¦®à§‡à¦¨à§ à¦¬à¦¾à¦° à¦¬à¦¨à§à¦§/à¦–à§‹à¦²à¦¾ à¦•à¦°à§à¦¨ (Collapse/Expand top bar)">
                <i class="fa-solid fa-chevron-up"></i>
            </button>

            <div class="workspace-body">
                <!-- Preview Panel (Sticky/Always visible on larger screens) -->
                <div class="preview-panel" id="main-preview-panel">
                    <div class="preview-panel-dock-placeholder" id="preview-panel-dock-placeholder" style="display: none;">
                        <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 32px; color: var(--primary, #6366f1); margin-bottom: 8px;"></i>
                        <span style="font-weight: 600; font-size: 15px;">à¦ªà§à¦²à§‡à¦¹à§‡à¦¡ à¦­à¦¾à¦¸à¦®à¦¾à¦¨ à¦‰à¦‡à¦¨à§à¦¡à§‹à¦¤à§‡ à¦¸à¦•à§à¦°à¦¿à¦¯à¦¼ (Floating Playhead Active)</span>
                        <span style="font-size: 12px; opacity: 0.7;">à¦¡à¦• à¦«à¦¿à¦°à§‡ à¦ªà§‡à¦¤à§‡ à¦­à¦¾à¦¸à¦®à¦¾à¦¨ à¦‰à¦‡à¦¨à§à¦¡à§‹à¦° 'X' à¦¬à¦¾ à¦‰à¦ªà¦°à§‡à¦° à¦¬à¦¾à¦Ÿà¦¨à§‡ à¦•à§à¦²à¦¿à¦• à¦•à¦°à§à¦¨</span>
                    </div>

                    <div class="canvas-container" id="canvas-container">
                        <div class="canvas-floating-header" id="canvas-floating-header" style="display: none;">
                            <span class="cf-title"><i class="fa-solid fa-up-down-left-right"></i> à¦­à¦¾à¦¸à¦®à¦¾à¦¨ à¦ªà§à¦²à§‡à¦¹à§‡à¦¡ (Drag to reposition)</span>
                            <div style="display:flex;align-items:center;gap:6px;">
                                <button type="button" id="canvas-safezone-btn-float" class="cf-fs-btn" title="à¦¸à§‡à¦« à¦œà§‹à¦¨ à¦—à¦¾à¦‡à¦¡ à¦…à¦¨/à¦…à¦« à¦•à¦°à§à¦¨ (Toggle Safe Zone)"><i class="fa-solid fa-shield-halved"></i></button>
                                <button type="button" id="canvas-snapshot-btn-float" class="cf-fs-btn" title="à¦ªà§à¦²à§‡ à¦¸à§à¦•à§à¦°à¦¿à¦¨à§‡à¦° à¦¸à§à¦•à§à¦°à¦¿à¦¨à¦¶à¦Ÿ à¦¨à¦¿à¦¨ (Take Snapshot)"><i class="fa-solid fa-camera"></i></button>
                                <button type="button" id="canvas-fullscreen-btn-float" class="cf-fs-btn" title="à¦«à§à¦²à¦¸à§à¦•à§à¦°à¦¿à¦¨ à¦ªà§à¦°à¦¿à¦­à¦¿à¦‰ â€” à¦¸à§à¦•à§à¦°à¦¿à¦¨ à¦°à§‡à¦•à¦°à§à¦¡à¦¿à¦‚à¦¯à¦¼à§‡à¦° à¦œà¦¨à§à¦¯ (Fullscreen Preview)"><i class="fa-solid fa-expand"></i></button>
                                <button type="button" class="cf-close-btn" id="cf-close-btn" title="à¦¡à¦• à¦ªà§à¦¯à¦¾à¦¨à§‡à¦²à§‡ à¦«à¦¿à¦°à§‡ à¦¯à¦¾à¦¨"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        </div>
                        <!-- Canvas for video rendering + logo overlay -->
                        <canvas id="editor-canvas"></canvas>

                        <!-- Canvas Action Buttons Overlay (bottom-right) -->
                        <div class="canvas-overlay-actions" id="canvas-overlay-actions" style="display:none;">
                            <button type="button" id="canvas-safezone-btn" class="canvas-overlay-btn active safezone-active" title="Meta / FB Reels Boost Safe Zone à¦—à¦¾à¦‡à¦¡ à¦…à¦¨/à¦…à¦« (Toggle Safe Zone Overlay)">
                                <i class="fa-solid fa-shield-halved"></i> <span>à¦¸à§‡à¦« à¦œà§‹à¦¨</span>
                            </button>
                            <button type="button" id="canvas-snapshot-btn" class="canvas-overlay-btn" title="à¦ªà§à¦²à§‡ à¦¸à§à¦•à§à¦°à¦¿à¦¨à§‡à¦° à¦¸à§à¦•à§à¦°à¦¿à¦¨à¦¶à¦Ÿ à¦¨à¦¿à¦¨ (Take Snapshot)">
                                <i class="fa-solid fa-camera"></i> <span>à¦¸à§à¦•à§à¦°à¦¿à¦¨à¦¶à¦Ÿ</span>
                            </button>
                            <button type="button" id="canvas-fullscreen-btn" class="canvas-overlay-btn" title="à¦«à§à¦²à¦¸à§à¦•à§à¦°à¦¿à¦¨ à¦ªà§à¦°à¦¿à¦­à¦¿à¦‰ â€” à¦¸à§à¦•à§à¦°à¦¿à¦¨ à¦°à§‡à¦•à¦°à§à¦¡à¦¿à¦‚à¦¯à¦¼à§‡à¦° à¦œà¦¨à§à¦¯ (Fullscreen Preview)">
                                <i class="fa-solid fa-expand"></i> <span>à¦«à§à¦²à¦¸à§à¦•à§à¦°à¦¿à¦¨</span>
                            </button>
                        </div>
                        
                        <!-- Drag-and-drop placeholder when no video -->
                        <div class="upload-placeholder" id="video-dropzone">
                            <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
                            <h3>Drag & Drop Video or Photo Here</h3>
                            <p>Or click to browse files (MP4, WebM, PNG, JPG)</p>
                            <span class="file-spec">Create video slideshows using photos</span>
                            <input type="file" id="video-input" accept="video/*, image/*" multiple style="display: none;">
                        </div>

                        <!-- Video playhead/timeline overlay (bottom-left) -->
                        <div class="canvas-overlay-controls" style="display: none;">
                            <i class="fa-regular fa-clock" style="font-size: 11px; opacity: 0.85; margin-right: 2px;"></i>
                            <span id="canvas-time-display">00:00 / 00:00</span>
                        </div>
                    </div>

                    <!-- Fullscreen Preview Overlay (for screen recording) -->
                    <div id="sf-fullscreen-wrapper">
                        <video id="sf-fullscreen-video" autoplay muted playsinline></video>
                        <div id="sf-fullscreen-controls">
                            <button id="sf-fs-playpause" title="Play / Pause"><i class="fa-solid fa-play"></i></button>
                            <span id="sf-fs-time">00:00 / 00:00</span>
                            <button id="sf-fs-exit" title="à¦«à§à¦²à¦¸à§à¦•à§à¦°à¦¿à¦¨ à¦¥à§‡à¦•à§‡ à¦¬à§‡à¦° à¦¹à¦¨ (ESC à¦šà¦¾à¦ªà§à¦¨)"><i class="fa-solid fa-compress"></i> à¦¬à§‡à¦° à¦¹à¦¨</button>
                        </div>
                    </div>

                    <!-- Generic Keyframe Animation Panel (Phase 11) -->
                    <div id="keyframe-panel-mount"></div>


                    <!-- Custom Timeline Control -->
                    <div class="timeline-bar" style="display: none;" id="timeline-controls">
                        <!-- Seek/scrub bar â€” freely move the playhead forward/back without changing the trim range -->
                        <div class="seek-bar-container">
                            <span class="seek-time-label" id="seek-current-time">00:00.0</span>
                            <div class="seek-slider-wrapper">
                                <div class="seek-track-bg"></div>
                                <div class="seek-track-fill" id="seek-fill"></div>
                                <input type="range" id="seek-slider" min="0" max="100" value="0" step="0.01">
                            </div>
                            <span class="seek-time-label" id="seek-total-time">00:00.0</span>
                        </div>

                        <div class="timeline-bar-top-row">
                            <button id="play-pause-btn" class="btn-play">
                                <i class="fa-solid fa-play"></i>
                            </button>
                            <div class="preview-volume-container" style="display: flex; align-items: center; gap: 6px; margin-left: 8px; flex-shrink: 0;">
                                <button id="preview-mute-btn" class="btn-play" title="à¦ªà§à¦°à¦¿à¦­à¦¿à¦‰ à¦¸à¦¾à¦‰à¦¨à§à¦¡ à¦…à¦«/à¦…à¦¨ à¦•à¦°à§à¦¨ â€” à¦¶à§à¦§à§ à¦†à¦ªà¦¨à¦¾à¦° à¦¸à§à¦ªà¦¿à¦•à¦¾à¦°à§‡à¦° à¦œà¦¨à§à¦¯, à¦à¦•à§à¦¸à¦ªà§‹à¦°à§à¦Ÿ à¦•à¦°à¦¾ à¦­à¦¿à¦¡à¦¿à¦“à¦° à¦…à¦¡à¦¿à¦“à¦¤à§‡ à¦•à§‹à¦¨à§‹ à¦ªà§à¦°à¦­à¦¾à¦¬ à¦ªà¦¡à¦¼à¦¬à§‡ à¦¨à¦¾ (Mute preview only)" style="background: rgba(148, 163, 184, 0.15); border: 1.5px solid #94a3b8; color: #94a3b8; border-radius: 50%; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;" type="button">
                                    <i class="fa-solid fa-volume-high"></i>
                                </button>
                                <input type="range" id="preview-volume-slider" min="0" max="1" step="0.05" value="1" title="à¦¸à¦¾à¦‰à¦¨à§à¦¡ à¦­à¦²à¦¿à¦‰à¦® à¦•à¦®à¦¾à¦¨/à¦¬à¦¾à¦¾à§œà¦¾à¦¨ (Volume Control)" style="width: 55px; accent-color: var(--primary); cursor: pointer; height: 6px; border-radius: 3px; background: rgba(255,255,255,0.1); border: none; outline: none; margin: 0 4px 0 0;">
                            </div>
                            <button id="split-clip-btn" class="btn-play" title="Split clip at playhead (à¦ªà§à¦²à§‡à¦¹à§‡à¦¡à§‡ à¦•à§à¦²à¦¿à¦ª à¦¬à¦¿à¦­à¦•à§à¦¤ à¦•à¦°à§à¦¨)" style="background: rgba(239, 68, 68, 0.15); border: 1.5px solid #ef4444; color: #ef4444; border-radius: 50%; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; margin-left: 8px; flex-shrink: 0;" type="button">
                                <i class="fa-solid fa-scissors"></i>
                            </button>
                            <button id="freeze-frame-btn" class="btn-play" title="à¦ªà§à¦²à§‡à¦¹à§‡à¦¡à§‡à¦° à¦«à§à¦°à§‡à¦®à§‡ à¦­à¦¿à¦¡à¦¿à¦“ à¦•à¦¿à¦›à§à¦•à§à¦·à¦£à§‡à¦° à¦œà¦¨à§à¦¯ à¦¥à¦¾à¦®à¦¿à¦¯à¦¼à§‡ à¦°à¦¾à¦–à§à¦¨ â€” à¦…à¦¡à¦¿à¦“à¦° à¦¸à¦¾à¦¥à§‡ à¦¸à¦¿à¦™à§à¦• à¦®à§‡à¦²à¦¾à¦¤à§‡ à¦¸à¦¾à¦¹à¦¾à¦¯à§à¦¯ à¦•à¦°à§‡ (Freeze Frame)" style="background: rgba(56, 189, 248, 0.15); border: 1.5px solid #38bdf8; color: #38bdf8; border-radius: 50%; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; margin-left: 6px; flex-shrink: 0;" type="button">
                                <i class="fa-solid fa-pause"></i>
                            </button>
                            <input type="number" id="freeze-frame-duration" title="à¦«à§à¦°à¦¿à¦œ à¦«à§à¦°à§‡à¦®à§‡à¦° à¦¦à§ˆà¦°à§à¦˜à§à¦¯ (à¦¸à§‡à¦•à§‡à¦¨à§à¦¡)" value="1.5" min="0.2" max="5" step="0.1" style="width: 52px; height: 38px; margin-left: 4px; background: rgba(56,189,248,0.08); border: 1px solid rgba(56,189,248,0.4); color: #38bdf8; border-radius: 6px; text-align: center; font-size: 12px; flex-shrink: 0;">
                            <div class="timeline-slider-container">
                                <!-- Dual range slider for trimming -->
                                <div class="slider-track-bg"></div>
                                <div class="slider-track-fill" id="trim-fill"></div>
                                <input type="range" id="trim-start" class="trim-slider" min="0" max="100" value="0" step="0.01">
                                <input type="range" id="trim-end" class="trim-slider" min="0" max="100" value="100" step="0.01">
                                <div class="playhead" id="playhead-indicator"></div>
                            </div>
                            <div class="time-inputs" style="display: flex; align-items: flex-end; gap: 8px;">
                                <div class="time-field">
                                    <label>Start</label>
                                    <input type="text" id="start-time-val" value="00:00.0">
                                </div>
