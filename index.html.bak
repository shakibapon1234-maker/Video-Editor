                                    <!-- Edit Text B-roll Section (Phase 5D) -->
                                    <div id="broll-edit-text-section" style="display: none; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 15px; margin-top: 15px;">
                                        <h4 style="font-size: 13px; color: var(--primary); margin-bottom: 10px;"><i class="fa-solid fa-font"></i> Text Settings (à¦Ÿà§‡à¦•à§à¦¸à¦Ÿ à¦¸à§‡à¦Ÿà¦¿à¦‚à¦¸)</h4>
                                        <div class="control-group">
                                            <label>Edit Text Content (à¦Ÿà§‡à¦•à§à¦¸à¦Ÿ à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨ à¦•à¦°à§à¦¨)</label>
                                            <textarea id="broll-edit-text-input" class="form-textarea" rows="4" placeholder="à¦¯à§‡à¦®à¦¨à¦ƒ à¦¢à¦¾à¦•à¦¾ à¦Ÿà§ à¦•à¦•à§à¦¸à¦¬à¦¾à¦œà¦¾à¦°"></textarea>
                                        </div>
                                        <div class="control-group mt-2" style="display:flex; align-items:center; gap:16px;">
