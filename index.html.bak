    <script src="exporter.js?v=4"></script>
    <script src="phase9.js?v=5"></script>
    <script src="transitions-library.js?v=1"></script>
    <script src="multitrack.js?v=4"></script>
    <script src="subtitle-import.js?v=1"></script>
    <script src="text-find-replace.js?v=1"></script>
    <script src="lower-third-presets.js?v=1"></script>
    <script src="custom-fonts.js?v=1"></script>
    <script src="bangla-spellcheck.js?v=1"></script>
    <script src="film-grain.js?v=1"></script>
    <!-- Floating/Draggable Playhead Control (mirrors main seek bar; can be repositioned anywhere) -->
    <div class="floating-transport" id="floating-transport">
        <div class="floating-transport-handle" id="floating-transport-handle">
            <span class="ft-title"><i class="fa-solid fa-up-down-left-right"></i> à¦ªà§à¦²à§‡à¦¹à§‡à¦¡</span>
            <button class="floating-transport-close" id="floating-transport-close" type="button" title="à¦¬à¦¨à§à¦§ à¦•à¦°à§à¦¨">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="floating-transport-body">
            <div class="floating-transport-controls">
                <button class="ft-play-btn" id="ft-play-btn" type="button">
                    <i class="fa-solid fa-play" id="ft-play-icon"></i>
                </button>
                <span class="ft-time" id="ft-current-time">00:00.0</span>
                <div class="ft-seek-wrapper">
                    <div class="ft-seek-track-bg"></div>
                    <div class="ft-seek-track-fill" id="ft-seek-fill"></div>
                    <input type="range" id="ft-seek-slider" class="ft-seek-slider" min="0" max="100" value="0" step="0.01">
                </div>
                <span class="ft-time" id="ft-total-time">00:00.0</span>
            </div>
        </div>
    </div>

    <!-- Keyboard Shortcuts Cheat-Sheet Modal -->
    <script>
        function openShortcutsModal() {
            var modal = document.getElementById('shortcuts-modal');
            if (modal) {
                modal.style.setProperty('display', 'flex', 'important');
                modal.style.setProperty('z-index', '9999999', 'important');
            }
        }
        function closeShortcutsModal() {
            var modal = document.getElementById('shortcuts-modal');
            if (modal) {
                modal.style.setProperty('display', 'none', 'important');
            }
        }
    </script>
    <div id="shortcuts-modal" class="modal-overlay" style="display: none; z-index: 9999999;" onclick="if(event.target === this) closeShortcutsModal();">
        <div class="modal-card" style="max-width: 600px; width: 90%;">
            <div class="modal-header">
                <h3><i class="fa-solid fa-keyboard" style="color: #818cf8; margin-right: 8px;"></i> à¦•à§€à¦¬à§‹à¦°à§à¦¡ à¦¶à¦°à§à¦Ÿà¦•à¦¾à¦Ÿ à¦•à¦¿ (Keyboard Shortcuts)</h3>
                <button id="close-shortcuts-modal" class="modal-close" type="button" onclick="closeShortcutsModal();"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body" style="padding: 20px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; font-size: 13px;">
                    <div style="background: rgba(255,255,255,0.04); padding: 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);">
                        <div style="color: #a5b4fc; font-weight: 600; margin-bottom: 8px;">ðŸš€ à¦•à§à¦‡à¦• à¦¨à§‡à¦­à¦¿à¦—à§‡à¦¶à¦¨:</div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;"><span>ðŸ”¤ à¦Ÿà§‡à¦•à§à¦¸à¦Ÿ à¦“à¦­à¦¾à¦°à¦²à§‡:</span><kbd style="background: #334155; color: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace;">T / Alt+T</kbd></div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;"><span>ðŸŽžï¸ B-roll à¦®à¦¿à¦¡à¦¿à¦¯à¦¼à¦¾:</span><kbd style="background: #334155; color: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace;">B / Alt+B</kbd></div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;"><span>ðŸŽ¬ à¦à¦•à§à¦¸à¦ªà§‹à¦°à§à¦Ÿ / à¦°à§‡à¦¨à§à¦¡à¦¾à¦°:</span><kbd style="background: #334155; color: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace;">E / Alt+E</kbd></div>
                        <div style="display: flex; justify-content: space-between;"><span>ðŸ“Œ à¦¸à§à¦Ÿà§‡à¦ª à§§-à§« à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨:</span><kbd style="background: #334155; color: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace;">Alt + 1 ~ 5</kbd></div>
                    </div>
                    <div style="background: rgba(255,255,255,0.04); padding: 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08);">
                        <div style="color: #a5b4fc; font-weight: 600; margin-bottom: 8px;">âª à¦à¦¡à¦¿à¦Ÿà¦¿à¦‚ à¦“ à¦ªà§à¦²à§‡à¦¬à§à¦¯à¦¾à¦•:</div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;"><span>â†©ï¸ à¦†à¦¨à¦¡à§ (Undo):</span><kbd style="background: #334155; color: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace;">Ctrl + Z</kbd></div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;"><span>â†ªï¸ à¦°à¦¿à¦¡à§ (Redo):</span><kbd style="background: #334155; color: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace;">Ctrl + Y</kbd></div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;"><span>â–¶ï¸ à¦ªà§à¦²à§‡ / à¦ªà¦œ:</span><kbd style="background: #334155; color: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace;">Spacebar</kbd></div>
                        <div style="display: flex; justify-content: space-between;"><span>âœ‚ï¸ à¦Ÿà§à¦°à¦¿à¦® In / Out:</span><kbd style="background: #334155; color: #fff; padding: 2px 6px; border-radius: 4px; font-family: monospace;">I / O</kbd></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="padding: 12px 20px; text-align: right;">
                <button id="close-shortcuts-modal-btn" class="btn btn-primary" type="button" onclick="closeShortcutsModal();">à¦ à¦¿à¦• à¦†à¦›à§‡ (Got it)</button>
            </div>
        </div>
    </div>

    <!-- Snapshot Modal (Canvas Preview Snapshot) -->
    <div class="modal-overlay" id="snapshot-modal" style="display: none; z-index: 999999;">
        <div class="modal-card" style="max-width: 560px; width: 92%;">
            <div class="modal-header">
                <h3><i class="fa-solid fa-camera" style="color: var(--primary, #6366f1);"></i> à¦ªà§à¦°à¦¿à¦­à¦¿à¦‰ à¦¸à§à¦•à§à¦°à¦¿à¦¨à¦¶à¦Ÿ (Preview Snapshot)</h3>
                <button class="modal-close" id="close-snapshot-modal-btn" type="button"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body" style="padding: 18px 24px; text-align: center;">
                <div style="margin-bottom: 12px; position: relative; border-radius: 8px; overflow: hidden; background: #000; border: 1px solid var(--border-color, #334155); display: flex; align-items: center; justify-content: center; max-height: 280px; box-shadow: 0 4px 16px rgba(0,0,0,0.4);">
                    <img id="snapshot-preview-img" src="" alt="Snapshot Preview" style="max-width: 100%; max-height: 280px; object-fit: contain;">
                    <span id="snapshot-time-badge" style="position: absolute; bottom: 8px; right: 8px; background: rgba(15,23,42,0.85); color: #e2e8f0; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,0.15);">00:00.0</span>
                </div>
                <p style="font-size: 13px; color: var(--text-secondary, #94a3b8); margin-bottom: 8px; line-height: 1.5;">
                    à¦•à§à¦¯à¦¾à¦ªà¦šà¦¾à¦°à¦•à§ƒà¦¤ à¦¸à§à¦•à§à¦°à¦¿à¦¨à¦¶à¦Ÿà¦Ÿà¦¿ à¦ªà§à¦°à¦œà§‡à¦•à§à¦Ÿ à¦Ÿà¦¾à¦‡à¦®à¦²à¦¾à¦‡à¦¨à§‡ à¦¨à¦¤à§à¦¨ à¦‡à¦®à§‡à¦œ à¦•à§à¦²à¦¿à¦ª à¦¹à¦¿à¦¸à§‡à¦¬à§‡ à¦¯à§‹à¦— à¦•à¦°à¦¤à§‡ à¦ªà¦¾à¦°à§‡à¦¨ à¦¬à¦¾ à¦ªà¦¿à¦¸à¦¿à¦¤à§‡ à¦¡à¦¾à¦‰à¦¨à¦²à§‹à¦¡ à¦•à¦°à§‡ à¦¨à¦¿à¦¤à§‡ à¦ªà¦¾à¦°à§‡à¦¨à¥¤
                </p>
            </div>
            <div class="modal-footer" style="padding: 14px 24px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; border-top: 1px solid var(--border-color, #334155);">
                <button type="button" class="btn btn-secondary" id="snapshot-close-btn">à¦¬à¦¨à§à¦§ à¦•à¦°à§à¦¨</button>
                <button type="button" class="btn btn-outline" id="snapshot-copy-btn" title="à¦•à§à¦²à¦¿à¦ªà¦¬à§‹à¦°à§à¦¡à§‡ à¦•à¦ªà¦¿ à¦•à¦°à§à¦¨"><i class="fa-regular fa-copy"></i> à¦•à¦ªà¦¿</button>
                <button type="button" class="btn btn-success" id="snapshot-download-btn" style="background: #10b981; border-color: #10b981; color: #fff;"><i class="fa-solid fa-download"></i> Save PNG</button>
                <button type="button" class="btn btn-primary" id="snapshot-add-timeline-btn" style="background: var(--primary, #6366f1); border-color: var(--primary, #6366f1); color: #fff;"><i class="fa-solid fa-plus"></i> à¦Ÿà¦¾à¦‡à¦®à¦²à¦¾à¦‡à¦¨à§‡ à¦¯à§‹à¦— à¦•à¦°à§à¦¨</button>
            </div>
        </div>
    </div>

    <script src="punch-zoom-ui.js?v=4"></script>
    <script src="ui-customization.js?v=6"></script>
</body>
</html>
