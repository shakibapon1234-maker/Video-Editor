                                    <div class="control-group mt-3">
                                        <label>à¦®à§‹à¦¡ (Mode)</label>
                                        <select id="addaudio-mode-select" class="form-select">
                                            <option value="replace">Replace Original Audio (à¦†à¦—à§‡à¦° à¦¸à¦¾à¦‰à¦¨à§à¦¡ à¦¬à¦¦à¦²à§‡ à¦¦à¦¿à¦¨)</option>
                                            <option value="mix">Mix with Original Audio (à¦†à¦—à§‡à¦° à¦¸à¦¾à¦‰à¦¨à§à¦¡à§‡à¦° à¦¸à¦¾à¦¥à§‡ à¦®à¦¿à¦¶à¦¿à¦¯à¦¼à§‡ à¦¦à¦¿à¦¨)</option>
                                        </select>
