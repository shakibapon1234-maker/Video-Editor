                                        </div>
                                    </div>

                                    <div class="color-grade-channel mt-3">
                                        <label class="color-grade-channel-label" style="color:#ef4444;"><i class="fa-solid fa-circle" style="font-size:8px;"></i> Red Channel</label>
                                        <div class="control-group mt-2">
                                            <label>Shadows</label>
                                            <div class="slider-val-container">
                                                <input type="range" id="grade-r-shadow" min="-100" max="100" value="0">
                                                <span id="grade-r-shadow-val">0</span>
                                            </div>
                                        </div>
                                        <div class="control-group mt-2">
                                            <label>Midtones</label>
                                            <div class="slider-val-container">
                                                <input type="range" id="grade-r-mid" min="-100" max="100" value="0">
                                                <span id="grade-r-mid-val">0</span>
                                            </div>
                                        </div>
                                        <div class="control-group mt-2">
                                            <label>Highlights</label>
                                            <div class="slider-val-container">
                                                <input type="range" id="grade-r-high" min="-100" max="100" value="0">
                                                <span id="grade-r-high-val">0</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="color-grade-channel mt-4">
                                        <label class="color-grade-channel-label" style="color:#22c55e;"><i class="fa-solid fa-circle" style="font-size:8px;"></i> Green Channel</label>
                                        <div class="control-group mt-2">
                                            <label>Shadows</label>
                                            <div class="slider-val-container">
                                                <input type="range" id="grade-g-shadow" min="-100" max="100" value="0">
                                                <span id="grade-g-shadow-val">0</span>
                                            </div>
                                        </div>
                                        <div class="control-group mt-2">
                                            <label>Midtones</label>
                                            <div class="slider-val-container">
                                                <input type="range" id="grade-g-mid" min="-100" max="100" value="0">
                                                <span id="grade-g-mid-val">0</span>
                                            </div>
                                        </div>
                                        <div class="control-group mt-2">
                                            <label>Highlights</label>
                                            <div class="slider-val-container">
                                                <input type="range" id="grade-g-high" min="-100" max="100" value="0">
                                                <span id="grade-g-high-val">0</span>
                                            </div>
                                        </div>
                                    </div>

