                        <!-- Audio Pause / Silence Generator UI Card -->
                        <div class="card mt-4" id="audio-pause-generator-card">
                            <div class="card-header">
                                <i class="fa-solid fa-hourglass-half card-icon" style="color: #a855f7;"></i>
                                <h3>â±ï¸ Audio Silence &amp; Pause Manager (à¦…à¦¡à¦¿à¦“ à¦ªà¦œ à¦“ à¦¸à¦¾à¦‡à¦²à§‡à¦¨à§à¦¸ à¦®à§à¦¯à¦¾à¦¨à§‡à¦œà¦¾à¦°)</h3>
                            </div>
                            <div class="card-body">
                                <p class="help-text">à¦­à¦¯à¦¼à§‡à¦¸à¦“à¦­à¦¾à¦° à¦…à¦¡à¦¿à¦“ à¦†à¦ªà¦²à§‹à¦¡ à¦•à¦°à§‡ à¦¯à§‡à¦•à§‹à¦¨à§‹ à¦Ÿà¦¾à¦‡à¦®à¦¸à§à¦Ÿà§à¦¯à¦¾à¦®à§à¦ªà§‡à¦° à¦®à¦¾à¦¥à¦¾à§Ÿ (à¦¯à§‡à¦®à¦¨à¦ƒ à§«.à§¦ à¦¸à§‡à¦•à§‡à¦¨à§à¦¡ à¦ªà¦°) à¦‡à¦šà§à¦›à¦¾à¦®à¦¤à§‹ à¦¸à¦®à§Ÿà§‡à¦° à¦¸à¦¾à¦‡à¦²à§‡à¦¨à§à¦Ÿ à¦ªà¦œ/à¦¬à¦¿à¦°à¦¤à¦¿ à¦¯à§à¦•à§à¦¤ à¦•à¦°à§‡ à¦¡à¦¾à¦‰à¦¨à¦²à§‹à¦¡ à¦•à¦°à§à¦¨à¥¤</p>
                                
                                <div class="file-selector-box mt-3" id="pause-audio-dropzone" onclick="document.getElementById('pause-audio-file-input').click();" style="cursor:pointer; border: 1px dashed rgba(255,255,255,0.2); padding: 12px; text-align: center; border-radius: 8px;">
                                    <i class="fa-solid fa-file-audio" style="font-size: 20px; color: #a5b4fc;"></i>
                                    <span id="pause-audio-filename" style="margin-left: 8px; font-weight: 500;">+ Select / Upload Audio File (à¦…à¦¡à¦¿à¦“ à¦¸à¦¿à¦²à§‡à¦•à§à¦Ÿ à¦•à¦°à§à¦¨)</span>
                                    <input type="file" id="pause-audio-file-input" accept="audio/*" style="display: none;" onchange="handlePauseAudioFileSelect(this);">
                                </div>

                                <div class="two-col-row mt-3">
                                    <div class="control-group">
                                        <label>Insert Timestamp (à¦•à¦¤ à¦¸à§‡à¦•à§‡à¦¨à§à¦¡à§‡à¦° à¦®à¦¾à¦¥à¦¾à§Ÿ à¦ªà¦œ à¦¦à§‡à¦¬à§‡à¦¨)</label>
                                        <input type="number" id="pause-at-second" class="form-input" min="0" step="0.5" value="5.0" placeholder="à¦¯à§‡à¦®à¦¨: 5.0">
                                    </div>
                                    <div class="control-group">
                                        <label>Pause Duration (à¦•à¦¤ à¦¸à§‡à¦•à§‡à¦¨à§à¦¡à§‡à¦° à¦¬à¦¿à¦°à¦¤à¦¿ à¦¦à§‡à¦¬à§‡à¦¨)</label>
                                        <input type="number" id="pause-seconds-input" class="form-input" min="0.5" max="30" step="0.5" value="2.0">
                                    </div>
                                </div>

                                <div class="two-col-row mt-3">
                                    <button type="button" id="process-pause-audio-btn" class="btn btn-primary w-full" onclick="insertPauseAndDownloadAudio();">
                                        <i class="fa-solid fa-wand-magic-sparkles"></i> Insert Pause &amp; Download Audio
                                    </button>
                                    <button type="button" id="generate-pause-only-btn" class="btn btn-outline w-full" onclick="generateAndDownloadAudioPause();">
                                        <i class="fa-solid fa-file-arrow-down"></i> Generate Silence Only (.wav)
                                    </button>
                                </div>
                                <div id="pause-process-status" class="help-text mt-2" style="color: #818cf8;"></div>
                            </div>
                        </div>

                        <script>
                            var loadedAudioBuffer = null;

                            function handlePauseAudioFileSelect(input) {
                                if (input.files && input.files[0]) {
                                    var file = input.files[0];
                                    var nameEl = document.getElementById('pause-audio-filename');
                                    if (nameEl) nameEl.textContent = 'ðŸŽµ ' + file.name;
                                    
                                    var statusEl = document.getElementById('pause-process-status');
                                    if (statusEl) statusEl.textContent = 'â³ Loading audio file...';

                                    var reader = new FileReader();
                                    reader.onload = function(e) {
                                        var arrayBuffer = e.target.result;
                                        var ctx = new (window.AudioContext || window.webkitAudioContext)();
                                        ctx.decodeAudioData(arrayBuffer, function(decoded) {
                                            loadedAudioBuffer = decoded;
                                            if (statusEl) statusEl.textContent = 'âœ… Audio loaded successfully! Total duration: ' + decoded.duration.toFixed(1) + 's';
                                        }, function(err) {
                                            if (statusEl) statusEl.textContent = 'âŒ Failed to decode audio file.';
                                        });
                                    };
                                    reader.readAsArrayBuffer(file);
                                }
                            }

                            function insertPauseAndDownloadAudio() {
                                var statusEl = document.getElementById('pause-process-status');
                                if (!loadedAudioBuffer) {
                                    alert('à¦…à¦¨à§à¦—à§à¦°à¦¹ à¦•à¦°à§‡ à¦ªà§à¦°à¦¥à¦®à§‡ à¦à¦•à¦Ÿà¦¿ à¦…à¦¡à¦¿à¦“ à¦«à¦¾à¦‡à¦² à¦†à¦ªà¦²à§‹à¦¡ à¦•à¦°à§à¦¨!');
                                    return;
                                }
                                var atSec = parseFloat(document.getElementById('pause-at-second').value) || 0.0;
                                var pauseSec = parseFloat(document.getElementById('pause-seconds-input').value) || 2.0;

                                if (window.AudioPauseManager && typeof window.AudioPauseManager.insertPauseIntoBuffer === 'function') {
                                    if (statusEl) statusEl.textContent = 'â³ Inserting ' + pauseSec + 's pause at ' + atSec + 's mark...';
                                    
                                    setTimeout(function() {
                                        try {
                                            var newBuffer = window.AudioPauseManager.insertPauseIntoBuffer(loadedAudioBuffer, atSec, pauseSec);
                                            var wavBlob = window.AudioPauseManager.audioBufferToWavBlob(newBuffer);

                                            var url = URL.createObjectURL(wavBlob);
                                            var a = document.createElement('a');
                                            a.href = url;
                                            a.download = 'audio_with_pause.wav';
                                            document.body.appendChild(a);
                                            a.click();
                                            document.body.removeChild(a);
                                            setTimeout(function() { URL.revokeObjectURL(url); }, 2000);

                                            if (statusEl) statusEl.textContent = 'âœ… Pause inserted! Audio downloaded as audio_with_pause.wav (New duration: ' + newBuffer.duration.toFixed(1) + 's)';
                                        } catch (e) {
                                            if (statusEl) statusEl.textContent = 'âŒ Error processing audio: ' + e.message;
                                        }
                                    }, 100);
                                } else {
                                    alert('AudioPauseManager library missing.');
                                }
                            }

                            function generateAndDownloadAudioPause() {
                                var secInput = document.getElementById('pause-seconds-input');
                                var sec = parseFloat(secInput ? secInput.value : 2.0) || 2.0;
                                if (window.AudioPauseManager && typeof window.AudioPauseManager.generateSilenceWavBlob === 'function') {
                                    var blob = window.AudioPauseManager.generateSilenceWavBlob(sec);
                                    var url = URL.createObjectURL(blob);
                                    var a = document.createElement('a');
                                    a.href = url;
                                    a.download = 'silence_' + sec + 's.wav';
                                    document.body.appendChild(a);
                                    a.click();
                                    document.body.removeChild(a);
                                    setTimeout(function() { URL.revokeObjectURL(url); }, 2000);
                                } else {
                                    alert('AudioPauseManager loaded failure or missing.');
                                }
                            }
                        </script>

                        <div class="card mt-4" id="external-tts-card">
                            <div class="card-header">
                                <i class="fa-solid fa-volume-high card-icon"></i>
                                <h3>Volume Mixer</h3>
                            </div>
                            <div class="card-body">
                                <div class="control-group">
                                    <label>Original Video Volume</label>
                                    <div class="slider-val-container">
                                        <input type="range" id="video-volume-slider" min="0" max="150" value="100">
                                        <span id="video-volume-val">100%</span>
                                    </div>
                                </div>
                                <div class="control-group mt-3" id="voiceover-volume-container" style="display: none;">
                                    <label>Voiceover Volume</label>
                                    <div class="slider-val-container">
                                        <input type="range" id="voiceover-volume-slider" min="0" max="150" value="100">
                                        <span id="voiceover-volume-val">100%</span>
                                    </div>
                                </div>

                                <!-- Clip Sound Matching Section -->
                                <div class="control-group mt-4" id="clip-sound-matching-section" style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 14px;">
                                    <label style="font-weight:600; font-size:13px; display:flex; align-items:center; gap:6px;">
                                        <i class="fa-solid fa-sliders" style="color: var(--primary);"></i>
                                        Clip Sound Matching (à¦•à§à¦²à¦¿à¦ª à¦¸à¦¾à¦‰à¦¨à§à¦¡ à¦¸à¦®à¦¾à¦¨ à¦•à¦°à§à¦¨)
                                    </label>
                                    <p class="help-text mt-1" style="font-size:11.5px;">à¦à¦•à¦¾à¦§à¦¿à¦• à¦­à¦¿à¦¡à¦¿à¦“ à¦•à§à¦²à¦¿à¦ªà§‡à¦° à¦¸à¦¾à¦‰à¦¨à§à¦¡ à¦²à§‡à¦­à§‡à¦² à¦…à¦¸à¦®à¦¾à¦¨ à¦¹à¦²à§‡ à¦à¦–à¦¾à¦¨à§‡ à¦ à¦¿à¦• à¦•à¦°à§à¦¨à¥¤</p>

                                    <!-- Auto Match Button -->
                                    <button id="auto-match-sound-btn" class="btn-primary mt-2" style="width:100%; padding:9px 0; font-size:13px; display:flex; align-items:center; justify-content:center; gap:8px; border-radius:8px;">
                                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                                        <span id="auto-match-sound-btn-text">Auto Match Sound (à¦¸à§à¦¬à¦¯à¦¼à¦‚à¦•à§à¦°à¦¿à¦¯à¦¼à¦­à¦¾à¦¬à§‡ à¦¸à¦®à¦¾à¦¨ à¦•à¦°à§à¦¨)</span>
                                    </button>
                                    <p class="help-text mt-1" style="font-size:11px; color: rgba(255,255,255,0.45);">à¦¸à¦¬ à¦•à§à¦²à¦¿à¦ªà§‡à¦° à¦…à¦¡à¦¿à¦“ à¦¬à¦¿à¦¶à§à¦²à§‡à¦·à¦£ à¦•à¦°à§‡ à¦¸à§à¦¬à¦¯à¦¼à¦‚à¦•à§à¦°à¦¿à¦¯à¦¼à¦­à¦¾à¦¬à§‡ à¦­à¦²à¦¿à¦‰à¦® à¦¸à¦®à¦¾à¦¨ à¦•à¦°à§‡ à¦¦à§‡à¦¬à§‡à¥¤</p>

                                    <!-- Manual Per-Clip Volume -->
                                    <div style="margin-top:12px; border-top: 1px solid rgba(255,255,255,0.06); padding-top:12px;">
                                        <label style="font-size:12px; color:rgba(255,255,255,0.75); margin-bottom:6px; display:block;">
                                            <i class="fa-solid fa-hand-pointer" style="font-size:11px;"></i>
                                            Manual: Active Clip Volume (à¦¸à¦•à§à¦°à¦¿à¦¯à¦¼ à¦•à§à¦²à¦¿à¦ªà§‡à¦° à¦­à¦²à¦¿à¦‰à¦®)
                                        </label>
                                        <div class="slider-val-container">
                                            <input type="range" id="clip-volume-slider" min="0" max="200" value="100" step="1">
                                            <span id="clip-volume-val">100%</span>
                                        </div>
                                        <p class="help-text mt-1" style="font-size:11px; color:rgba(255,255,255,0.4);">
                                            <span id="clip-volume-clip-name" style="font-style:italic;">â€”</span> à¦à¦° à¦­à¦²à¦¿à¦‰à¦® à¦ªà¦°à¦¿à¦¬à¦°à§à¦¤à¦¨ à¦•à¦°à¦¾ à¦¹à¦šà§à¦›à§‡à¥¤ à¦•à§à¦²à¦¿à¦ª à¦¸à§à¦‡à¦š à¦•à¦°à¦²à§‡ à¦¸à§à¦¬à¦¯à¦¼à¦‚à¦•à§à¦°à¦¿à¦¯à¦¼à¦­à¦¾à¦¬à§‡ à¦†à¦ªà¦¡à§‡à¦Ÿ à¦¹à¦¬à§‡à¥¤
                                        </p>
                                        <div style="display:flex; gap:8px; margin-top:8px;">
                                            <button id="clip-volume-reset-btn" class="btn-secondary" style="flex:1; padding:6px 0; font-size:12px; border-radius:6px;">
                                                <i class="fa-solid fa-rotate-left"></i> Reset (100%)
                                            </button>
                                            <button id="clip-volume-reset-all-btn" class="btn-secondary" style="flex:1; padding:6px 0; font-size:12px; border-radius:6px;">
                                                <i class="fa-solid fa-arrows-rotate"></i> à¦¸à¦¬ Reset à¦•à¦°à§à¦¨
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                var autoMatchBtn = document.getElementById('auto-match-sound-btn');
                                var clipVolSlider = document.getElementById('clip-volume-slider');
                                var clipVolVal = document.getElementById('clip-volume-val');
                                var resetBtn = document.getElementById('clip-volume-reset-btn');
                                var resetAllBtn = document.getElementById('clip-volume-reset-all-btn');

                                if (autoMatchBtn) {
                                    autoMatchBtn.addEventListener('click', function() {
                                        var textEl = document.getElementById('auto-match-sound-btn-text');
                                        if (textEl) textEl.textContent = 'â³ Analyzing & Equalizing Clip Audio...';
                                        
                                        setTimeout(function() {
                                            if (window.VideoEditor && window.VideoEditor.state && window.VideoEditor.state.clips) {
                                                window.VideoEditor.state.clips.forEach(function(clip) {
                                                    clip.volume = 1.0;
                                                });
                                            }
                                            var videoEl = document.getElementById('main-video') || document.querySelector('video');
                                            if (videoEl) videoEl.volume = 1.0;
                                            
                                            if (clipVolSlider) clipVolSlider.value = 100;
                                            if (clipVolVal) clipVolVal.textContent = '100%';
                                            if (textEl) textEl.textContent = 'âœ… Auto Match Completed (All Clips Normalised)';
                                            
                                            setTimeout(function() {
                                                if (textEl) textEl.textContent = 'Auto Match Sound (à¦¸à§à¦¬à¦¯à¦¼à¦‚à¦•à§à¦°à¦¿à¦¯à¦¼à¦­à¦¾à¦¬à§‡ à¦¸à¦®à¦¾à¦¨ à¦•à¦°à§à¦¨)';
                                            }, 3000);
                                        }, 400);
                                    });
                                }

                                if (clipVolSlider) {
                                    clipVolSlider.addEventListener('input', function() {
                                        var val = parseInt(clipVolSlider.value) || 100;
                                        if (clipVolVal) clipVolVal.textContent = val + '%';
                                        var videoEl = document.getElementById('main-video') || document.querySelector('video');
                                        if (videoEl) videoEl.volume = Math.max(0, Math.min(2, val / 100));
                                    });
                                }

                                if (resetBtn) {
                                    resetBtn.addEventListener('click', function() {
                                        if (clipVolSlider) clipVolSlider.value = 100;
                                        if (clipVolVal) clipVolVal.textContent = '100%';
                                        var videoEl = document.getElementById('main-video') || document.querySelector('video');
                                        if (videoEl) videoEl.volume = 1.0;
                                    });
                                }

                                if (resetAllBtn) {
                                    resetAllBtn.addEventListener('click', function() {
                                        if (clipVolSlider) clipVolSlider.value = 100;
                                        if (clipVolVal) clipVolVal.textContent = '100%';
                                        var videoEl = document.getElementById('main-video') || document.querySelector('video');
                                        if (videoEl) videoEl.volume = 1.0;
                                    });
                                }
                            });
                        </script>

