{
  "name": "studio-flow-video-editor",
  "version": "1.0.0",
  "description": "Studio Flow Video Editor with Server-Side Rendering support",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dist": "electron-builder",
    "postinstall": "node copy-wasm.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@huggingface/transformers": "^4.2.0",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.studioflow.videoeditor",
    "productName": "Studio Flow Video Editor",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "**/*",
      "!temp_render/**",
      "!temp_mute/**",
      "!temp_addaudio/**",
      "!exports/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
